# Copie para .env e preencha. NUNCA faça commit do arquivo .env.

# Banco PostgreSQL
DATABASE_URL=postgres://usuario:senha@localhost:5432/caixa

# Primeiro administrador (usado só se ainda não existir nenhum usuário). Apague a senha depois do primeiro acesso.
ADMIN_EMAIL=
ADMIN_NOME=
ADMIN_SENHA_INICIAL=

# Segredo usado para autenticar a chamada agendada de sincronização (gere com: openssl rand -hex 32)
CRON_SECRET=

# Integração CHServer / Integrador BI (somente leitura). Deixe em branco para desativar.
# Endereço externo do CHServerWeb, sem barra no final. Ex.: http://servidor:8080
CHSERVER_URL=
CHSERVER_TOKEN=
CHSERVER_CNPJ=
CHSERVER_CHAVE_EMPRESA=
# Empresa e conta do caixa que recebem os títulos do CHServer
CHSERVER_EMPRESA_SLUG=primetech-loja
CHSERVER_CONTA_NOME=Banco
